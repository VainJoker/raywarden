{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raywarden",
  "main": "build/index.js",
  "compatibility_date": "2026-01-06",
  // Preserve Dashboard variables; reconcile them before changing this policy.
  "keep_vars": true,
  // Use the default workers.dev address; a custom domain is optional.
  "workers_dev": true,
  "preview_urls": false,
  // The pinned Web Vault rejects HTTP API origins, including localhost.
  "dev": {
    "local_protocol": "https"
  },

  // Local builds and dry-runs; artifact deployment skips this command.
  "build": {
    "command": "just build"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "3101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SEND_ACCESS_RATE_LIMITER",
      "namespace_id": "3103",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  // Deployment derives DOMAIN from the public endpoint and uploads it as a Secret.
  // ALLOWED_EMAILS is a comma/newline-separated list of exact account emails, supplied as a Secret.
  // KEY_ENCRYPTION_KEY is an independent 32-byte base64url Secret; never put it in vars.
  "secrets": {
    "required": ["DOMAIN", "ALLOWED_EMAILS", "KEY_ENCRYPTION_KEY"]
  },
  // Optional settings are documented in README.md and DEPLOYMENT.md.
  "vars": {
    "DISABLE_USER_REGISTRATION": "true",
    // Global application log level: off, error, warn, info, debug, or trace.
    "LOG_LEVEL": "info"
    // Optional overrides:
    // "CLIENT_SUPPRESS_ONBOARDING": "false",
    // "VW_CSS_SIGNUP_DISABLED": "true",
    // "VW_CSS_SENDS_ALLOWED": "true",
    // "VW_CSS_PASSWORD_HINTS_ALLOWED": "true",
    // "VW_CSS_REMEMBER_2FA_DISABLED": "false",
    // "NOTIFY_LEVEL": "warning",
    // "NOTIFY_EVENTS": "all",
    // "CORS_ALLOWED_ORIGINS": "",
  },
  // Daily 03:00 UTC: cleanup and global-domain cache refresh.
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warden-db",
      "database_id": "849abb49-78b2-4ce9-a901-840d6fd50172",
      "migrations_dir": "sql/migrations"
    }
  ],
  "observability": {
    // Notification/file capability URLs contain credentials. Hide query strings
    // in both logs and traces, and keep only application logs by default.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "warden-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "notifydo",
        "class_name": "notifydo"
      },
      {
        "name": "heavydo",
        "class_name": "heavydo"
      }
    ]
  },
  // Durable Object class migrations; D1 migrations live in sql/migrations.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "notifydo",
        "heavydo"
      ]
    }
  ],
  // Dynamic paths enter the Worker first; other requests follow normal asset routing.
  "assets": {
    "directory": "./static/web-vault",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/setup",
      "/setup/*",
      "/identity/*",
      "/accounts/*",
      "/attachments/*",
      "/ciphers/*",
      "/sends/*",
      "/alive",
      "/alive/*",
      "/two-factor/*",
      "/notifications/*",
      "/events/*",
      "/icons/*",
      "/css/vaultwarden.css",
      "/css/vaultwarden.css/*",
      "/js/raywarden.js",
      "/js/raywarden.js/*",
      "/send-verify",
      "/send-verify/*",
      "/.well-known/*"
    ]
  },

  "env": {
    "local": {
      "name": "raywarden-local",
      "workers_dev": false,
      "routes": [],

      // Keep production Cron triggers out of local development.
      "triggers": {
        "crons": []
      },

      "observability": {
        "enabled": false
      },

      // Local commands omit the production secrets declaration in their generated config.
      "vars": {
        "DOMAIN": "https://localhost:8787",
        "ALLOWED_EMAILS": "owner@example.test",
        // Public development-only key (bytes 0..31). Never use it in production.
        "KEY_ENCRYPTION_KEY": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8",
        "DISABLE_USER_REGISTRATION": "true",
        // Global application log level.
        "LOG_LEVEL": "info",
        // Client onboarding is independent of registration permissions.
        "CLIENT_SUPPRESS_ONBOARDING": "false",
        // Dynamic CSS switches control presentation, not API authorization/capabilities.
        "VW_CSS_SIGNUP_DISABLED": "true",
        "VW_CSS_SENDS_ALLOWED": "true",
        "VW_CSS_PASSWORD_HINTS_ALLOWED": "true",
        "VW_CSS_REMEMBER_2FA_DISABLED": "false",
        // Minimum severity: info, warning (warn), error.
        "NOTIFY_LEVEL": "warning",
        // none | all | comma-separated event names. Channels use local .dev.vars:
        // WEWORK_WEBHOOK_URL, or TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID.
        "NOTIFY_EVENTS": "none",
        // Comma-separated origins; empty/* allows all without cookie credentials.
        "CORS_ALLOWED_ORIGINS": ""
      },

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "raywarden-local",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "sql/migrations"
        }
      ],

      "r2_buckets": [
        {
          "binding": "ATTACHMENTS_BUCKET",
          "bucket_name": "raywarden-attachments-local"
        }
      ],

      "ratelimits": [
        {
          "name": "LOGIN_RATE_LIMITER",
          "namespace_id": "4101",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "SEND_ACCESS_RATE_LIMITER",
          "namespace_id": "4103",
          "simple": {
            "limit": 15,
            "period": 60
          }
        }
      ],

      "durable_objects": {
        "bindings": [
          {
            "name": "notifydo",
            "class_name": "notifydo"
          },
          {
            "name": "heavydo",
            "class_name": "heavydo"
          }
        ]
      },

      "migrations": [
        {
          "tag": "v1-notify-heavy",
          "new_sqlite_classes": [
            "notifydo",
            "heavydo"
          ]
        }
      ]
    }
  }
}
