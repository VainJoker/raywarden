{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raywarden",
  "main": "build/index.js",
  "compatibility_date": "2026-01-06",
  // Preserve Dashboard variables; reconcile them before changing this policy.
  "keep_vars": true,
  // Use the default workers.dev address; a custom domain is optional.
  "workers_dev": true,
  "preview_urls": false,
  // Local builds and dry-runs; artifact deployment skips this command.
  "build": {
    "command": "just build"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "3101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SEND_ACCESS_RATE_LIMITER",
      "namespace_id": "3103",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  // Deployment derives DOMAIN from the public endpoint and uploads it as a Secret.
  // ALLOWED_EMAILS is one owner email, supplied by GitHub Secrets on first deployment.
  "secrets": {
    "required": ["DOMAIN", "ALLOWED_EMAILS"]
  },
  // Optional settings and credentials: docs/runtime-config.md.
  "vars": {
    "DISABLE_USER_REGISTRATION": "true",
    "HEAVY_DO_SHARDS": "1",
    // Global level plus optional overrides: info,auth=debug,db=warn,external=debug,notify=info
    // Levels: off, error, warn, info, debug, trace. Modules: auth, api, db, external, notify.
    "LOG_LEVEL": "info",
    // Optional overrides: uncomment to manage these in this file.
    // Examples stay commented to preserve existing Dashboard values with keep_vars.
    // Suppress the client's welcome, extension and advanced-feature onboarding.
    // "CLIENT_SUPPRESS_ONBOARDING": "false",
    // Dynamic CSS presentation switches; API capabilities and authorization are separate.
    // "VW_CSS_SIGNUP_DISABLED": "true",
    // "VW_CSS_SENDS_ALLOWED": "true",
    // "VW_CSS_PASSWORD_HINTS_ALLOWED": "true",
    // "VW_CSS_SSO_ENABLED": "false",
    // "VW_CSS_SSO_ONLY": "false",
    // "VW_CSS_PASSKEY_2FA_SUPPORTED": "true",
    // "VW_CSS_PASSKEY_LOGIN_ENABLED": "true",
    // "VW_CSS_REMEMBER_2FA_DISABLED": "false",
    // "VW_CSS_MAIL_2FA_ENABLED": "true",
    // Omit MAIL_ENABLED to follow MAIL_WEBHOOK_URL availability automatically.
    // "VW_CSS_MAIL_ENABLED": "false",
    // "VW_CSS_YUBICO_ENABLED": "false",
    // "VW_CSS_DUO_ENABLED": "false",
    // "VW_CSS_EMERGENCY_ACCESS_ALLOWED": "false",
    // "VW_CSS_LOAD_USER_CSS": "true",
    // "VW_CSS_USER": "",
    // Minimum level: info, warning (or warn), error. Unset defaults to info.
    // "NOTIFY_LEVEL": "warning",
    // none | all | comma-separated event names. Channels use Worker Secrets:
    // WEWORK_WEBHOOK_URL, or TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID.
    // Events: login,login_failed,password_hint,password,email,kdf,cipher_create,cipher_update,
    // cipher_delete,import,send_create,send_delete,2fa_enable,2fa_disable,2fa_recovery_code_view,
    // 2fa_recover,token_refresh,sync,auth_request,auth_response,webauthn_credential_create,
    // webauthn_credential_delete,webauthn_credential_update,webauthn_login.
    // Unset/none disables administrative notifications; previous Ray event names remain accepted.
    // "NOTIFY_EVENTS": "all",
    // Opt-in self-test page; its operations still require normal API authorization.
    // "DEMO_PAGE_ENABLED": "false",
    // Comma-separated origins. Empty/* allows all without cookie credentials.
    // Invalid restrictive lists deny cross-origin access. ALLOWED_ORIGINS remains a fallback alias.
    // "CORS_ALLOWED_ORIGINS": "",
  },
  // Daily 03:00 UTC: cleanup and global-domain cache refresh.
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "warden-db",
      "database_name": "warden-db",
      "database_id": "6bb5ee22-69d1-4f71-a9c2-8ff1187b988e",
      "migrations_dir": "sql/migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_BUCKET",
      "bucket_name": "warden-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFY_DO",
        "class_name": "NotifyDo"
      },
      {
        "name": "HEAVY_DO",
        "class_name": "HeavyDo"
      }
    ]
  },
  // Durable Object class migrations; D1 migrations live in sql/migrations.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NotifyDo",
        "HeavyDo"
      ]
    }
  ],
  // Dynamic paths enter the Worker first; other requests follow normal asset routing.
  "assets": {
    "directory": "./static/web-vault",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/setup",
      "/setup/*",
      "/demo.html",
      "/demo.html/*",
      "/identity/*",
      "/accounts/*",
      "/attachments/*",
      "/ciphers/*",
      "/sends/*",
      "/alive",
      "/two-factor/*",
      "/notifications/*",
      "/events/*",
      "/icons/*",
      "/css/vaultwarden.css",
      "/js/raywarden.js",
      "/send-verify",
      "/.well-known/*"
    ]
  },
}
